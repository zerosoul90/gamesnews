# Copy thành .env rồi điền. KHÔNG commit .env.
# Mọi giá trị dưới đây là placeholder, không phải secret thật.

# --- App ---
APP_ENV=dev
APP_PORT=8000
LOG_LEVEL=INFO

# --- Kho dữ liệu (giá trị mặc định khớp docker-compose.yml) ---
MONGO_URI=mongodb://mongo:27017
MONGO_DB=gamesnews
REDIS_URL=redis://redis:6379/0
MEILI_URL=http://meilisearch:7700
QDRANT_URL=http://qdrant:6333

# Trần thời gian cho mỗi lần ping phụ thuộc trong /health (giây).
HEALTH_TIMEOUT_SECONDS=2.0

# Meilisearch từ chối chạy ở chế độ production nếu thiếu key này.
# Sinh bằng: openssl rand -base64 32
MEILI_MASTER_KEY=doi-gia-tri-nay-truoc-khi-chay

# --- Key ngoài (Phase 1 trở đi mới dùng, Phase 0 để trống vẫn chạy) ---
# https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
# https://dev.twitch.tv/console/apps — cùng cặp key này dùng cho IGDB
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
