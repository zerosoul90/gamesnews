# Copy thành .env rồi điền. KHÔNG commit .env.
# Mọi giá trị dưới đây là placeholder, không phải secret thật.
#
# Thứ tự các nhóm đi theo mức bắt buộc: nhóm đầu phải có thì app mới chạy,
# nhóm cuối thiếu thì chỉ mất tính năng tương ứng (và log sẽ nói rõ mất cái gì
# — không có tính năng nào im lặng bỏ qua khi thiếu key).

# --- App ---
APP_ENV=dev
APP_PORT=8000
LOG_LEVEL=INFO

# --- Kho dữ liệu (giá trị mặc định khớp docker-compose.yml) ---
MONGO_URI=mongodb://mongo:27017
MONGO_DB=gamesnews
REDIS_URL=redis://redis:6379/0
MEILI_URL=http://meilisearch:7700
QDRANT_URL=http://qdrant:6333

# Trần thời gian cho mỗi lần ping phụ thuộc trong /health (giây).
HEALTH_TIMEOUT_SECONDS=2.0

# Trần thời gian HTTP của worker (giây). Rộng hơn hẳn cái trên: đẩy một batch
# nghìn document sang Meilisearch mất vài giây là bình thường.
JOB_TIMEOUT_SECONDS=30.0

# Meilisearch từ chối chạy ở chế độ production nếu thiếu key này.
# Sinh bằng: openssl rand -base64 32
MEILI_MASTER_KEY=doi-gia-tri-nay-truoc-khi-chay

# --- Admin ---
# Để trống thì /admin và /admin/api/* đóng hoàn toàn (503/401).
# Sinh bằng: openssl rand -base64 32
ADMIN_TOKEN=

# --- Auth người dùng ---
# Ký JWT phiên đăng nhập. ĐỔI trước khi chạy thật: giá trị mặc định trong mã
# nguồn công khai nghĩa là ai cũng ký được token của bất kỳ user nào.
# Sinh bằng: openssl rand -base64 48
JWT_SECRET=changeme_for_production
# Nơi trả người dùng về sau khi đăng nhập Steam xong.
FRONTEND_URL=http://localhost:3000
# Origin được phép gọi API từ trình duyệt, phân tách bằng dấu phẩy.
CORS_ORIGINS=http://localhost:4200,http://localhost:4000

# --- Key ngoài ---
# Bắt buộc cho catalog Steam (Phase 1) và thư viện người dùng (Phase 3).
# https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Phase 7, phần streamer Twitch. Console developer của Twitch bắt buộc bật 2FA
# bằng số điện thoại — nếu không lấy được thì bỏ trống, webhook Twitch sẽ trả
# 503 và phần YouTube vẫn chạy bình thường.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Chuỗi ta tự đặt khi đăng ký EventSub, dùng kiểm chữ ký HMAC mỗi notification.
# Để trống thì /webhooks/twitch từ chối phục vụ.
# Sinh bằng: openssl rand -base64 32
TWITCH_WEBHOOK_SECRET=

# Phase 7, phần streamer YouTube.
# Bí mật gửi kèm khi đăng ký WebSub, để kiểm X-Hub-Signature.
YOUTUBE_WEBSUB_SECRET=
# Data API v3. Dùng để phân biệt "vừa mở live" với "vừa đăng video" —
# notification WebSub không phân biệt được hai thứ đó. Thiếu key thì hệ thống
# vẫn ghi nhận video nhưng KHÔNG gửi push, và ghi log cảnh báo.
YOUTUBE_API_KEY=
# URL công khai của chính server này, để hub WebSub biết đẩy notification về
# đâu. Thiếu thì job gia hạn subscription không chạy được.
PUBLIC_BASE_URL=

# Phase 6, tóm tắt + dịch tin và sinh vector cho tầng 3 gắn entity.
# https://aistudio.google.com/apikey
# Thiếu thì crawler vẫn chạy, nhưng tin ra feed dạng chưa dịch và tầng 3 tắt.
GEMINI_API_KEY=

# --- Firebase Cloud Messaging (Phase 3, push) ---
# Ba giá trị lấy từ file JSON service account của Firebase. Thiếu bất kỳ giá
# trị nào thì send_push_notification ghi log lỗi và trả 0 — KHÔNG im lặng coi
# như đã gửi.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# Chuỗi PEM một dòng, xuống dòng viết thành \n.
FCM_PRIVATE_KEY=
